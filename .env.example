# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port (Node.js Manager / Passenger / Cloud Run)
PORT=3000

# Application Configuration
APP_NAME="TapEmpire"
APP_ENV="production"
APP_DEBUG=false

# Database Configuration (MySQL 8.0.39+ / MariaDB 10.11+)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="tapempire"
DB_USERNAME="tap_user"
DB_PASSWORD="tap_secret_password"

# Security & Session Authentication Secrets (Cryptographically random 256-bit strings)
ADMIN_JWT_SECRET="generate-64-character-hex-secret-for-admin-jwt"
USER_AUTH_SECRET="generate-64-character-hex-secret-for-user-auth"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
TELEGRAM_BOT_USERNAME="TapEmpireBot"
TELEGRAM_WEBHOOK_URL="https://yourdomain.com/api/telegram/webhook"
TELEGRAM_MINI_APP_URL="https://yourdomain.com"

# Game Economy Defaults
COIN_NAME="Empire Coin"
COIN_SYMBOL="EPC"
MAX_ENERGY=1000
TAP_ENERGY_COST=1
ENERGY_REGEN_RATE=1
ENERGY_REGEN_INTERVAL=3
REFERRAL_L1_PERCENT=10
REFERRAL_L2_PERCENT=3
REFERRAL_L3_PERCENT=1
MIN_WITHDRAWAL=10000
WITHDRAWAL_FEE_PERCENT=5
